{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "microduck-build-journal",
  "compatibility_date": "2026-09-08",
  "assets": { "directory": "./dist/client", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
